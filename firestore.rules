rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPedido(data) {
      return data.nomeCompleto is string && data.nomeCompleto.size() <= 500
        && data.produto is string && data.produto.size() <= 500
        && data.valorTotal is number
        && data.comissao is number
        && (data.status == "Pendente" || data.status == "Agendado" || data.status == "Entregue")
        && data.textoOriginal is string && data.textoOriginal.size() <= 15000;
    }

    match /pedidos/{pedidoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPedido(incoming());
      allow update: if isSignedIn() && isValidPedido(incoming());
      allow delete: if isSignedIn();
    }
  }
}
