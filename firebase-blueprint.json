{
  "entities": {
    "pedido": {
      "title": "Pedido",
      "description": "Ficha de pedido de móveis interpretada via WhatsApp",
      "type": "object",
      "properties": {
        "numeroVenda": {
          "type": "string",
          "description": "Número sequencial ou identificador do pedido"
        },
        "data": {
          "type": "string",
          "description": "Data do pedido formatada (ex: 04/05)"
        },
        "nomeCompleto": {
          "type": "string",
          "description": "Nome completo do cliente"
        },
        "telefone1": {
          "type": "string",
          "description": "Telefone principal de contato"
        },
        "telefone2": {
          "type": "string",
          "description": "Telefone secundário de contato"
        },
        "endereco": {
          "type": "string",
          "description": "Endereço completo para entrega"
        },
        "produto": {
          "type": "string",
          "description": "Nome do produto/móvel"
        },
        "cor": {
          "type": "string",
          "description": "Cor ou acabamento do móvel"
        },
        "quantidade": {
          "type": "integer",
          "description": "Quantidade comprada"
        },
        "formaPagamento": {
          "type": "string",
          "description": "Forma de pagamento (Dinheiro, Pix, Cartão, etc.)"
        },
        "valorTotal": {
          "type": "number",
          "description": "Preço total cobrado do cliente em R$"
        },
        "comissao": {
          "type": "number",
          "description": "Valor da comissão a receber em R$"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "RESCHEDULED", "DELIVERED_UNPAID", "DELIVERED"],
          "description": "Situação do pedido"
        },
        "textoOriginal": {
          "type": "string",
          "description": "Ficha original inteira copiada do WhatsApp"
        },
        "observacoes": {
          "type": "string",
          "description": "Observações adicionais extraídas ou digitadas"
        },
        "userId": {
          "type": "string",
          "description": "ID do usuário do Firebase correspondente"
        },
        "supplier": {
          "type": "string",
          "enum": ["SOFIA_HOME_DECOR", "MICHAEL", "FRANK", "OUTROS"],
          "description": "Fornecedor / Empresa do pedido"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "nomeCompleto",
        "produto",
        "valorTotal",
        "comissao",
        "status",
        "textoOriginal"
      ]
    },
    "backupMetadata": {
      "title": "BackupMetadata",
      "description": "Metadados de backup e segurança de vendas",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora em que o backup foi gerado"
        },
        "recordsCount": {
          "type": "integer",
          "description": "Quantidade total de pedidos contidos no backup"
        },
        "responsibleUser": {
          "type": "string",
          "description": "E-mail do vendedor ou termo 'sistema' responsável pelo backup"
        },
        "fileSize": {
          "type": "string",
          "description": "Tamanho legível do arquivo de backup (ex: 24.5 KB)"
        },
        "backupType": {
          "type": "string",
          "enum": ["manual", "automatico"],
          "description": "Origem do backup (manual por clique, ou automático diário)"
        },
        "backupData": {
          "type": "string",
          "description": "JSON completo contendo a lista dos pedidos em formato de texto"
        }
      },
      "required": [
        "createdAt",
        "recordsCount",
        "responsibleUser",
        "fileSize",
        "backupType",
        "backupData"
      ]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "pedido",
      "description": "Coleção de pedidos cadastrados por vendedores de móveis"
    },
    "system_backups/{backupId}": {
      "schema": "backupMetadata",
      "description": "Coleção de metadados e arquivos de backup automático/manual salvos no sistema"
    }
  }
}
